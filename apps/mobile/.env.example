# Convex deployment URL (same for web and mobile)
EXPO_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Mobile requires a development build (expo-dev-client), not Expo Go.
# Build once: cd apps/mobile && npx expo run:ios  (or eas build --profile development)

# Optional OAuth — set via `npm run auth` or manually in Google Cloud / Apple Developer
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
